# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://127.0.0.1:27017/rohit_portfolio
# MongoDB Atlas (recommended for deployment):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rohit_portfolio?retryWrites=true&w=majority

# ── JWT Auth (admin) ─────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Admin panel default credentials (used by npm run seed) ──
ADMIN_EMAIL=admin@rohit.com
ADMIN_PASSWORD=admin123

# ── CORS ────────────────────────────────────────────────
# Local React dev server:
CLIENT_URL=http://localhost:5173
# Production frontend (set after deploying the client):
# CLIENT_URL=https://your-frontend.vercel.app

# ── Contact-form email notifications (Nodemailer, optional) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_TO=your_email@gmail.com

# ── AI Chatbot (optional — real LLM replies) ──────────────
# Leave empty to use the built-in rule-based assistant (works 24/7 with no key).
# Set these to enable real AI answers via an OpenAI-compatible API.
# AI_API_KEY=sk-...
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
